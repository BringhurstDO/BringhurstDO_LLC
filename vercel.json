{
  "schedules": {
    "ops-autopublish-morning": {
      "path": "/api/cron/ops-autopublish/morning",
      "requestMethod": "GET",
      "schedule": "0 9 * * 1-6",
      "timezone": "America/New_York"
    },
    "ops-autopublish-midday": {
      "path": "/api/cron/ops-autopublish/midday",
      "requestMethod": "GET",
      "schedule": "0 12 * * 1-6",
      "timezone": "America/New_York"
    },
    "ops-autopublish-afternoon": {
      "path": "/api/cron/ops-autopublish/afternoon",
      "requestMethod": "GET",
      "schedule": "0 15 * * 1-6",
      "timezone": "America/New_York"
    },
    "ops-autopublish-evening": {
      "path": "/api/cron/ops-autopublish/evening",
      "requestMethod": "GET",
      "schedule": "0 18 * * 1-6",
      "timezone": "America/New_York"
    },
    "ops-autopublish-late-evening": {
      "path": "/api/cron/ops-autopublish/late-evening",
      "requestMethod": "GET",
      "schedule": "0 21 * * 1-6",
      "timezone": "America/New_York"
    },
    "ops-x-metrics-weekly": {
      "path": "/api/cron/ops-x-metrics",
      "requestMethod": "GET",
      "schedule": "0 10 * * 3",
      "timezone": "America/New_York"
    },
    "ops-meta-metrics-weekly": {
      "path": "/api/cron/ops-meta-metrics",
      "requestMethod": "GET",
      "schedule": "0 11 * * 3",
      "timezone": "America/New_York"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
